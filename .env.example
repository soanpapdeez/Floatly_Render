# Copy to .env and fill in. NEVER commit .env
# --- LLM (pick one; leave LLM_PROVIDER=mock to run with no key) ---
LLM_PROVIDER=mock            # mock | anthropic | openai
LLM_MODEL=                   # optional; sensible default per provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- PayPal (SANDBOX only) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUSINESS_EMAIL=