# ---- AI: "mock" works with no key. For a real model use any OpenAI-compatible API (free: Groq) ----
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your_own_free_groq_key
# LLM_MODEL=openai/gpt-oss-120b
EXTRACTOR_DEBUG=0

# ---- PayPal SANDBOX only (developer.paypal.com -> Sandbox) ----
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUSINESS_EMAIL=

# ---- demo helpers (optional) ----
DEMO_PAYER_EMAIL=
DEMO_CONTRACTOR_EMAIL=
DEMO_AMOUNT_SCALE=1

# ---- 1 = fake PayPal, no keys needed (judges). 0 = real sandbox ----
FLOAT_FAKE=1

# ---- Zapier "Catch Hook" URL (optional) ----
ZAPIER_WEBHOOK_URL=